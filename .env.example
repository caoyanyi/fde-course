# Generate real keys using: python3 scripts/configure.py --domain learn.example.com
# Keep the generated .env private. Never commit it to a repository.
APP_SETUP_TOKEN=
APP_MASTER_KEY=
PUBLIC_ORIGIN=http://localhost:18080
SESSION_COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
WEB_PORT=18080
MAX_REVIEWS_PER_DAY=30
# Optional exact hostnames for a deliberate private model service; empty by default.
AI_PRIVATE_HOST_ALLOWLIST=
